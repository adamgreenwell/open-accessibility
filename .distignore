# Files excluded from WordPress.org/runtime release packages.

# Repository and CI files.
/.git
/.github
.distignore
.gitattributes
.gitignore
.gitmodules

# Build and deployment output.
/bin
/build
/dist
/open-accessibility-svn
*.zip

# Development dependencies and tests.
/node_modules
/vendor
/coverage
/tests
phpunit.xml
phpunit.xml.dist
.phpunit.result.cache

# Development configs.
.editorconfig
Makefile
composer.json
composer.lock
package.json
package-lock.json
pnpm-lock.yaml
yarn.lock
phpcs.xml
phpcs.xml.dist

# Project-only documentation.
TRANSLATION_MAINTENANCE.md
/docs

# Local environment, editor, and OS files.
#
# .gitignore already excludes these, so they never reach the repository - but
# the release build copies from the working tree, not from git. Without them
# listed here an IDE directory ships straight into the package: 1.4.0 went out
# with .idea/ because of exactly this gap.
.idea
.idea/
.vscode
.vscode/
*.iml
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
.env
.env.*
*.log
*.sql
*.sqlite
*.swp
*.swo
*~
